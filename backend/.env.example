PORT=4000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL database name: smileyOS
DATABASE_URL=postgresql://postgres:ynassibi@localhost:5432/smileyOS?schema=public

# CRM login credentials
# These credentials are used to auto-create/update the admin user in DB at startup.
CRM_ADMIN_EMAIL=admin@smileyos.local
CRM_ADMIN_PASSWORD=change-me-now
JWT_SECRET=replace-with-a-long-random-secret

# Email settings (use your SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.smtp.user@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=SMILEY OS <your.smtp.user@gmail.com>
MAIL_TO=my.yassinenassibi@gmail.com
