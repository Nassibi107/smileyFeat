generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Lead {
  id          Int      @id @default(autoincrement())
  company     String
  value       Int      @default(0)
  rep         String   @default("AL")
  source      String   @default("LinkedIn")
  stage       String   @default("Lead Captured")
  daysInStage Int      @default(0)
  contact     String
  email       String
  phone       String?
  industry    String?
  website     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Booking {
  id             Int      @id @default(autoincrement())
  companyName    String
  website        String?
  industry       String
  companyStage   String
  monthlyRevenue String
  bottleneck     String?
  budgetRange    String?
  email          String
  phone          String?
  createdAt      DateTime @default(now())
}

model SiteContent {
  id              Int      @id
  heroTitle       String
  heroSubtitle    String
  aboutTitle      String
  aboutParagraph  String
  aboutHighlights Json
  updatedAt       DateTime @updatedAt
}

model TeamMember {
  id            Int      @id @default(autoincrement())
  name          String
  role          String
  specialty     String
  bio           String
  imageUrl      String?
  color         String   @default("#7A5CFF")
  displayOrder  Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DeliveryClient {
  id         Int      @id @default(autoincrement())
  name       String
  owner      String
  status     String   @default("Active")
  health     String   @default("Healthy")
  startDate  DateTime @default(now())
  progress   Int      @default(0)
  contract   Int      @default(0)
  services   Json
  team       Json
  stage      Int      @default(0)
  tasks      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Freelancer {
  id             Int      @id @default(autoincrement())
  name           String
  initials       String
  specialization String
  rating         Int      @default(4)
  rate           Int      @default(0)
  availability   String   @default("green")
  activeProjects Int      @default(0)
  utilization    Int      @default(0)
  profile        String
  projects       Json
  tasks          Json
  payments       Json
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Partner {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  description String
  website     String?
  logoUrl     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FinancialRecord {
  id            Int      @id @default(autoincrement())
  month         String
  clientName    String
  contract      Int      @default(0)
  freelancerCost Int     @default(0)
  opCost        Int      @default(0)
  status        String   @default("Healthy")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
